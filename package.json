{
  "name": "sponsor-gated-support-project",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "prod": "turbo run prod",
    "build": "turbo run build --concurrency=2",
    "check": "turbo run check --concurrency=2 && eslint . --max-warnings=0 && nova utility type-check --project tsconfig.config.json && nova utility type-check --project tsconfig.scripts.json && nova utility type-check --project tsconfig.tests.json && vitest run",
    "deploy": "turbo run deploy --concurrency=2",
    "clean": "turbo run clean",
    "changelog": "nova utility changelog",
    "recipes": "nova utility run-recipes --replace-file",
    "postinstall": "node ./scripts/link-nova.mjs"
  },
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^22 || ^24"
  },
  "devDependencies": {
    "@cbnventures/nova": "0.25.2",
    "jiti": "2.6.1",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "vitest": "4.1.3"
  },
  "overrides": {
    "webpack": ">=5.95.0 <5.106.0"
  }
}
