{
  "project": {
    "name": {
      "title": "Sponsor Gated Support",
      "slug": "sponsor-gated-support"
    },
    "description": {
      "short": "A GitHub Action that saves issue support for your sponsors and recognized contributors",
      "long": "Reply to, close, and lock support issues from anyone who isn't a sponsor, and welcome the ones who are. Eligibility checks live GitHub Sponsors data, contributors, and an exempt list, with an optional minimum amount and active-only rule."
    },
    "keywords": [
      "actions",
      "github-sponsors",
      "github-sponsors-action",
      "patreon",
      "customer-service"
    ],
    "legalName": "Jacky Liang",
    "pronouns": "personal",
    "platforms": [
      "nodejs",
      "web"
    ],
    "startingYear": 2024,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "author"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@mrjackyliang.com"
  },
  "github": {
    "owner": "mrjackyliang",
    "repo": "sponsor-gated-support",
    "topics": [
      "actions",
      "customer-service",
      "github-sponsors",
      "patreon",
      "github-sponsors-action"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false,
      "sponsorships": true
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "mergeCommit": {
        "title": "merge-message",
        "message": "pull-request-title"
      },
      "squashMerge": {
        "title": "commit-or-pull-request-title",
        "message": "commit-messages"
      },
      "autoDeleteHeadBranch": true,
      "autoMerge": false,
      "allowUpdateBranch": false,
      "webCommitSignoffRequired": false
    },
    "security": {
      "vulnerabilityAlerts": true,
      "dependabotSecurityUpdates": false,
      "secretScanning": true,
      "pushProtection": true
    },
    "rulesets": {
      "defaultBranch": {
        "enforcement": "active",
        "blockDeletions": true,
        "blockForcePushes": true,
        "requireLinearHistory": false,
        "requireSignedCommits": true,
        "requirePullRequest": false,
        "requiredStatusChecks": [],
        "requireBranchesToBeUpToDate": false
      }
    },
    "actions": {
      "enabled": true,
      "allowedActions": "all",
      "shaPinningRequired": false,
      "defaultWorkflowPermissions": "read",
      "canApprovePullRequestReviews": false,
      "artifactRetentionDays": 7
    },
    "labels": [
      {
        "name": "bug",
        "color": "d73a4a",
        "description": "Something isn't working"
      },
      {
        "name": "documentation",
        "color": "0075ca",
        "description": "Improvements or additions to documentation"
      },
      {
        "name": "duplicate",
        "color": "cfd3d7",
        "description": "This issue or pull request already exists"
      },
      {
        "name": "enhancement",
        "color": "a2eeef",
        "description": "New feature or request"
      },
      {
        "name": "good first issue",
        "color": "7057ff",
        "description": "Good for newcomers"
      },
      {
        "name": "help wanted",
        "color": "008672",
        "description": "Extra attention is needed"
      },
      {
        "name": "invalid",
        "color": "e4e669",
        "description": "This doesn't seem right"
      },
      {
        "name": "question",
        "color": "d876e3",
        "description": "Further information is requested"
      },
      {
        "name": "wontfix",
        "color": "ffffff",
        "description": "This will not be worked on"
      }
    ],
    "issueTemplate": {
      "bugReportFields": [
        "github-action"
      ],
      "customQuestions": {
        "bug": [
          {
            "type": "dropdown",
            "id": "eligibility-rule",
            "attributes": {
              "label": "Affected Eligibility Rule",
              "description": "Select the support eligibility rule involved.",
              "options": [
                "GitHub Sponsor",
                "Contributor Role",
                "Exempt List",
                "Minimum Sponsorship Amount",
                "Active Sponsorship Requirement",
                "Issue Labels",
                "Issue Comment Moderation",
                "Close or Lock Behavior",
                "Other"
              ]
            },
            "validations": {
              "required": true
            }
          },
          {
            "type": "dropdown",
            "id": "owner-type",
            "attributes": {
              "label": "Repository Owner Type",
              "description": "Select the type of account that owns the repository.",
              "options": [
                "Personal Account",
                "Organization"
              ]
            },
            "validations": {
              "required": false
            }
          }
        ],
        "feature": [
          {
            "type": "dropdown",
            "id": "eligibility-rule",
            "attributes": {
              "label": "Affected Eligibility Rule",
              "description": "Select the support eligibility rule involved.",
              "options": [
                "GitHub Sponsor",
                "Contributor Role",
                "Exempt List",
                "Minimum Sponsorship Amount",
                "Active Sponsorship Requirement",
                "Issue Labels",
                "Issue Comment Moderation",
                "Close or Lock Behavior",
                "Other"
              ]
            },
            "validations": {
              "required": true
            }
          }
        ],
        "support": [
          {
            "type": "dropdown",
            "id": "eligibility-rule",
            "attributes": {
              "label": "Affected Eligibility Rule",
              "description": "Select the support eligibility rule involved.",
              "options": [
                "GitHub Sponsor",
                "Contributor Role",
                "Exempt List",
                "Minimum Sponsorship Amount",
                "Active Sponsorship Requirement",
                "Issue Labels",
                "Issue Comment Moderation",
                "Close or Lock Behavior",
                "Other"
              ]
            },
            "validations": {
              "required": true
            }
          },
          {
            "type": "dropdown",
            "id": "owner-type",
            "attributes": {
              "label": "Repository Owner Type",
              "description": "Select the type of account that owns the repository.",
              "options": [
                "Personal Account",
                "Organization"
              ]
            },
            "validations": {
              "required": false
            }
          }
        ]
      }
    }
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "release"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 30,
      "build": [
        "./packages/sponsor-gated-support",
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "github-action",
          "path": "./packages/sponsor-gated-support"
        },
        {
          "to": "github-pages",
          "path": "./apps/docs",
          "artifact": "documentation"
        }
      ],
      "with": {
        "ACTION_ENTRY_POINT": "index.js",
        "ACTION_OUTPUT_PATH": "./packages/sponsor-gated-support/build",
        "ACTION_YML_PATH": "./action.yml",
        "RELEASE_BRANCH_NAME": "releases"
      }
    }
  ],
  "urls": {
    "homepage": "https://mrjackyliang.github.io/sponsor-gated-support/",
    "repository": "git+https://github.com/mrjackyliang/sponsor-gated-support.git",
    "bugs": "https://github.com/mrjackyliang/sponsor-gated-support/issues",
    "license": "https://github.com/mrjackyliang/sponsor-gated-support/blob/HEAD/LICENSE",
    "logo": "https://mrjackyliang.github.io/sponsor-gated-support/images/logo.svg",
    "documentation": "https://mrjackyliang.github.io/sponsor-gated-support/",
    "fundSources": [
      "https://github.com/sponsors/mrjackyliang",
      "https://liang.nyc/paypal"
    ],
    "privacyPolicy": "https://mrjackyliang.github.io/mrjackyliang/privacy/",
    "termsOfUse": "https://mrjackyliang.github.io/mrjackyliang/terms/"
  },
  "readme": {
    "badges": [
      "github-release",
      "github-top-language",
      "github-license",
      "coverage",
      "funding"
    ]
  },
  "workspaces": {
    "./": {
      "name": "sponsor-gated-support-project",
      "role": "project",
      "policy": "freezable"
    },
    "./apps/docs": {
      "name": "sponsor-gated-support-docs",
      "role": "docs",
      "policy": "freezable"
    },
    "./packages/sponsor-gated-support": {
      "name": "sponsor-gated-support",
      "role": "package",
      "policy": "trackable"
    }
  },
  "artifacts": {
    "documentation": {
      "build": [
        "./apps/docs"
      ],
      "sources": [
        {
          "from": "./apps/docs/build",
          "to": "./"
        }
      ]
    }
  },
  "ignoreFiles": {
    "./.gitignore": {
      "bundles": [
        "nova"
      ],
      "patterns": [
        "graphify-out/"
      ]
    }
  },
  "agents": [
    "claude-code",
    "codex"
  ],
  "recipes": {
    "github": {
      "sync-actions": {
        "enabled": true
      },
      "sync-features": {
        "enabled": true
      },
      "sync-identity": {
        "enabled": true
      },
      "sync-labels": {
        "enabled": true
      },
      "sync-policies": {
        "enabled": true
      },
      "sync-rulesets": {
        "enabled": true
      },
      "sync-security": {
        "enabled": true
      }
    },
    "github-action": {
      "sync-identity": {
        "enabled": true
      }
    },
    "license": {
      "update-copyright": {
        "enabled": true
      }
    },
    "miscellaneous": {
      "fix-markdown-tables": {
        "enabled": true
      },
      "remove-operating-system-files": {
        "enabled": true,
        "settings": {
          "linux": {},
          "macos": {
            "appleDouble": true,
            "desktopServicesStore": true
          },
          "windows": {
            "enhancedThumbnailDatabase": true,
            "enhancedVistaThumbnailDatabase": true,
            "thumbnailDatabase": true
          }
        }
      }
    },
    "nova-config": {
      "normalize-order": {
        "enabled": true
      }
    },
    "read-me": {
      "update-badges": {
        "enabled": true
      },
      "update-credits": {
        "enabled": true
      },
      "update-documentation": {
        "enabled": true
      },
      "update-header": {
        "enabled": true
      },
      "update-introduction": {
        "enabled": true
      }
    },
    "tsconfig": {
      "sync-references": {
        "enabled": true
      }
    },
    "package-json": {
      "./": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      },
      "./packages/sponsor-gated-support": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true,
          "settings": {
            "description": true,
            "keywords": true
          }
        },
        "sync-ownership": {
          "enabled": true,
          "settings": {
            "homepage": true,
            "bugs": true,
            "author": true,
            "contributors": true,
            "funding": true,
            "repository": true
          }
        }
      },
      "./apps/docs": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      }
    }
  },
  "environment": {
    "project": {
      "prefix": "PROJECT_"
    },
    "workspaces": {
      "./": {
        "prefix": "ROOT_"
      },
      "./apps/docs": {
        "prefix": "DOCS_"
      },
      "./packages/sponsor-gated-support": {
        "prefix": "ACTION_",
        "variables": [
          {
            "key": "ACTIONS_RUNNER_DEBUG",
            "reach": "local",
            "defaultValue": "false"
          },
          {
            "key": "ACTIONS_STEP_DEBUG",
            "reach": "local",
            "defaultValue": "false"
          },
          {
            "key": "INPUT_GITHUB_PERSONAL_ACCESS_TOKEN",
            "reach": "local",
            "defaultValue": ""
          },
          {
            "key": "INPUT_GITHUB_WORKFLOW_TOKEN",
            "reach": "local",
            "defaultValue": ""
          },
          {
            "key": "INPUT_ISSUE_LABELS",
            "reach": "local",
            "defaultValue": "support"
          },
          {
            "key": "INPUT_ISSUE_LIMIT_COMMENTER",
            "reach": "local",
            "defaultValue": "true"
          },
          {
            "key": "INPUT_ISSUE_LOCK_ON_CLOSE",
            "reach": "local",
            "defaultValue": "true"
          },
          {
            "key": "INPUT_ISSUE_MESSAGE_NOT_SPONSOR",
            "reach": "local",
            "defaultValue": "Apologies! Only sponsoring users are allowed to open issues. Please sponsor the owner of this repository, then try again."
          },
          {
            "key": "INPUT_ISSUE_MESSAGE_WELCOME",
            "reach": "local",
            "defaultValue": "Thank you for your support! We appreciate your sponsorship and are here to help. We will review your issue and get back to you as soon as possible."
          },
          {
            "key": "INPUT_IS_ORGANIZATION",
            "reach": "local",
            "defaultValue": "false"
          },
          {
            "key": "INPUT_SPONSOR_ACTIVE_ONLY",
            "reach": "local",
            "defaultValue": "true"
          },
          {
            "key": "INPUT_SPONSOR_EXEMPT_FILE_LOCATION",
            "reach": "local",
            "defaultValue": "./SPONSOR_EXEMPT"
          },
          {
            "key": "INPUT_SPONSOR_MINIMUM",
            "reach": "local",
            "defaultValue": "0"
          }
        ]
      }
    },
    "workflows": {
      "sponsor-check": {
        "prefix": "SGS_"
      }
    }
  },
  "settings": {
    "changelog": {
      "workspaceOrder": [
        "sponsor-gated-support"
      ]
    },
    "coverage": {
      "minimum": 95
    },
    "lockStepVersioning": true,
    "runWorkspaces": {
      "cache": {
        "enabled": true,
        "directory": "./node_modules/.cache/nova/run-workspaces",
        "scripts": [
          "build",
          "check"
        ]
      },
      "concurrency": {
        "build": 2,
        "check": 2,
        "deploy": 2
      }
    },
    "versionStrategy": "semver"
  }
}
